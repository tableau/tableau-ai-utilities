#!/usr/bin/env bash
# Reject git.soma pushes whose CODEOWNERS is not the git.soma compliance header.
#
# git.soma must carry EAR99 / Tableau CX. The public GitHub header stays on
# the public repo. A push whose URL is github.com is not checked here.
# A missing CODEOWNERS fails a git.soma push too.
#
# The check keys off the remote URL ($2). A raw URL push puts that URL in $1
# as well. publish-gh-pages.ts pushes the Pages branch by URL from a throwaway
# repo, so the URL check covers that push.
#
# Enable once per clone (replaces the default hooks path):
#   git config core.hooksPath scripts/githooks
#
# Args (git-provided):  $1 = remote name, $2 = remote URL
# Stdin (git-provided): <local ref> <local sha> <remote ref> <remote sha> lines
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

is_soma() {
  case "$1" in
    *git.soma.salesforce.com*) return 0 ;;
    *) return 1 ;;
  esac
}

if ! is_soma "$remote_url" && ! is_soma "$remote_name"; then
  exit 0
fi

SOMA_ECCN='#ECCN:EAR99'
SOMA_GUS='#GUSINFO:Tableau CX,Tableau CX'
PUBLIC_ECCN='#ECCN:Open Source'
PUBLIC_GUS='#GUSINFO:Open Source,Open Source Workflow'

zero='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if ! body="$(git show "${local_sha}:CODEOWNERS" 2>/dev/null)"; then
    echo "pre-push BLOCKED: CODEOWNERS is missing from ${local_ref} (${local_sha})." >&2
    fail=1
    continue
  fi

  if ! grep -F -q "$SOMA_ECCN" <<<"$body" || ! grep -F -q "$SOMA_GUS" <<<"$body"; then
    {
      echo ""
      echo "pre-push BLOCKED: CODEOWNERS in ${local_ref} must contain the git.soma header:"
      echo "  ${SOMA_ECCN}"
      echo "  ${SOMA_GUS}"
    } >&2
    fail=1
  fi

  if grep -F -q "$PUBLIC_ECCN" <<<"$body" || grep -F -q "$PUBLIC_GUS" <<<"$body"; then
    {
      echo ""
      echo "pre-push BLOCKED: CODEOWNERS in ${local_ref} carries the public GitHub header."
      echo "  ${PUBLIC_ECCN}"
      echo "  ${PUBLIC_GUS}"
    } >&2
    fail=1
  fi
done

exit "$fail"
